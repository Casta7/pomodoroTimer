{
    "manifest_version": 3,
    "name": "Pomodoro Timer",
    "version": "1.0.0",
    "description": "Un timer Pomodoro con interfaccia in Preact",
    "action": {
      "default_popup": "index.html"
    },
    "permissions": [
      "alarms",
      "notifications",
      "storage"
    ], 
    "background": {
      "service_worker": "background.js"
    }
}
  